# ── 运行环境 ──────────────────────────────────────────────
NODE_ENV=development
PORT=8080
API_BASE_URL=http://localhost:8080
CORS_ORIGINS=*

# ── 数据库（必填）─────────────────────────────────────────
DATABASE_URL=postgresql://proofnote:proofnote@localhost:5432/proofnote

# ── 认证 ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-32-byte-random-secret
AUTH_NONCE_TTL_SECONDS=600
ACCESS_TOKEN_TTL_SECONDS=3600

# ── 链配置（测试网 10143）─────────────────────────────────
CHAIN_ID=10143
CHAIN_NAME=Monad Testnet
RPC_URL_HTTP=https://testnet-rpc.monad.xyz
RPC_URL_PUBLIC=https://testnet-rpc.monad.xyz
RPC_URL_WS=wss://testnet-rpc.monad.xyz
EXPLORER_BASE_URL=https://testnet.monadscan.com
NATIVE_CURRENCY_SYMBOL=MON
NATIVE_CURRENCY_DECIMALS=18

# 合约地址（全部留空 = 自动进入 MOCK_CHAIN 模式，便于前端先行联调）
CONTRACT_NOTE_REGISTRY=
CONTRACT_SUPPORT_ROUTER=
CONTRACT_STREAM_SUPPORT=
CONTRACT_IMPACT_REGISTRY=
CONTRACT_ATTESTATION_REGISTRY=
CONTRACT_CAMPAIGN_TREASURY_FACTORY=

# ── 协议参数（回退值；运行时优先读链上 feeBps()）──────────
PROTOCOL_FEE_BPS_FALLBACK=200
PROTOCOL_FEE_RECIPIENT=

# ── 对象存储：local（本地磁盘，零依赖）或 s3（R2/S3 兼容）──
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/api/v1/files
# S3 驱动参数（STORAGE_DRIVER=s3 时必填）
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── 上传限制（MB）─────────────────────────────────────────
MAX_AVATAR_MB=5
MAX_IMAGE_MB=20
MAX_VIDEO_MB=200
MAX_EVIDENCE_MB=50

# ── Indexer ───────────────────────────────────────────────
INDEXER_POLL_INTERVAL_MS=2000
INDEXER_CHUNK_BLOCKS=2000
REORG_SAFETY_BLOCKS=12

# ── Reconcile ─────────────────────────────────────────────
RECONCILE_INTERVAL_MS=30000
