    "outputs": []
  },
  {
    "type": "function",
    "name": "settleExpired",
    "stateMutability": "nonpayable",
    "inputs": [{ "name": "streamId", "type": "uint256" }],
    "outputs": []
  },
  {
    "type": "function",
    "name": "withdraw",
    "stateMutability": "nonpayable",
    "inputs": [],
